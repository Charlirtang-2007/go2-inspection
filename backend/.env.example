# ============================================
# Go2 智能巡检系统 · 环境变量配置模板
# 复制为 .env 后填入真实值
# ============================================

# ---------- 机器人连接 ----------
# true=模拟模式（无硬件）；false=真机模式
USE_MOCK_ROBOT=true

# 真机模式下，连接机器狗的网卡名
# Linux 常见：enp2s0 / eth0 / end0
# Windows 下运行时填：以太网 / WLAN
ROBOT_NETWORK_INTERFACE=enp2s0

# ---------- 检测引擎 ----------
# yolo = 只用本地 YOLO 模型
# preset = 兜底方案
# vlm  = 只用云端视觉大模型
# both = 双路并行，任一检测到即告警（推荐比赛用）
DETECTION_ENGINE=preset+yolo+vlm
# YOLO 模型路径（相对于 backend/ 目录）
YOLO_MODEL_PATH=models/smoke.pt

# YOLO 置信度阈值（0-1），越低越敏感，误报越多
YOLO_CONF_THRESHOLD=0.1

# YOLO 推理输入尺寸（越大越准，CPU 越慢）
YOLO_IMGSZ=1280

# ---------- VLM（云端视觉大模型） ----------
# 比赛时若启用 DETECTION_ENGINE=vlm 或 both，必须填
VLM_API_KEY=

# 豆包（火山引擎）：https://ark.cn-beijing.volces.com/api/v3/chat/completions
# 千问（阿里云百炼）：https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VLM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 豆包模型名：doubao-seed-1-6-vision
# 千问模型名：qwen3-vl-plus
VLM_MODEL=doubao-seed-1-6-vision

# VLM 调用超时（秒）
VLM_TIMEOUT=30

# ---------- 检测 worker 参数 ----------
# 推理间隔（秒）
# YOLO 快：1.0 够用
# VLM 慢：建议 3.0
# both：建议 3.0
DETECTION_INTERVAL=3.0

# ---------- 告警通知 ----------
# PushPlus 微信推送 token：https://www.pushplus.plus/
PUSHPLUS_TOKEN=

# 企业微信群机器人 webhook
WECOM_WEBHOOK=

# 同类型异常通知冷却时间（秒），默认 5 分钟
NOTIFY_COOLDOWN=300

# ---------- 视频流 ----------
# MJPEG 输出分辨率（宽度x高度），越小越省 CPU
MJPEG_WIDTH=1280
MJPEG_HEIGHT=720

# MJPEG JPEG 编码质量（1-100）
MJPEG_QUALITY=80

# ---------- 录制 ----------
# 录制文件保留数量（全局）
RECORDING_KEEP_LAST=5

# 录制输出目录（相对于 backend/）
RECORDING_DIR=recordings

# ---------- 服务器 ----------
# 后端监听地址
HOST=0.0.0.0

# 后端监听端口
PORT=8000

# mDNS 服务类型（前端 Rust 发现后端用）
MDNS_SERVICE_TYPE=_go2-backend._tcp.local.

# ---------- 日志 ----------
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO